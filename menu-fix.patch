diff -urN '--exclude=.git' /tmp/w2/assets/css/components/menu-bar.css /tmp/w2-serve/assets/css/components/menu-bar.css
--- /tmp/w2/assets/css/components/menu-bar.css	1970-01-01 00:00:00.000000000 +0000
+++ /tmp/w2-serve/assets/css/components/menu-bar.css	2026-04-25 23:55:39.261976692 +0000
@@ -0,0 +1,78 @@
+/* ==========================================================================
+   MENU-BAR.CSS — barra horizontal de navegación (DESKTOP ≥960px)
+   --------------------------------------------------------------------------
+   · Vive dentro del .nav-inner como una columna del grid (auto 1fr auto).
+   · `display: contents` hace que el <ul> suba al grid del nav-inner, así
+     los items se alinean en la fila del header sin wrapper extra.
+   · Hidden por defecto (mobile) — ahí manda el .menu-drawer.
+   · Sin submenús ni footer aquí: si más adelante quieres dropdowns, viven
+     en este archivo (TODO al final).
+
+   Secciones (Ctrl+F):
+     1) BASE (oculto en mobile)
+     2) DESKTOP (≥960px)
+   ========================================================================== */
+
+
+/* === 1) BASE — oculto por defecto, manda el drawer en mobile ============== */
+
+.menu-bar { display: none; }
+
+
+/* === 2) DESKTOP (≥960px) ================================================== */
+
+@media (min-width: 960px) {
+  .menu-bar {
+    display: contents;        /* el <ul> sube al grid del .nav-inner */
+    color: inherit;           /* hereda el color del .nav (.nav-over-hero → blanco) */
+  }
+
+  .menu-bar-list {
+    justify-self: start;
+    display: flex;
+    flex-direction: row;
+    align-items: center;
+    gap: var(--sp-8);
+    list-style: none;
+    margin: 0; padding: 0;
+  }
+
+  .menu-bar-link {
+    position: relative;
+    display: inline-flex;
+    align-items: center;
+    padding: var(--sp-2) 0;
+    font: inherit;
+    font-size: 14px;
+    font-weight: var(--fw-medium);
+    color: inherit;
+    background: transparent;
+    border: 0;
+    cursor: pointer;
+    -webkit-tap-highlight-color: transparent;
+  }
+
+  /* Underline animado al hover/active.
+     scale-X 0→1 da una entrada limpia desde la izquierda. */
+  .menu-bar-link::before {
+    content: "";
+    position: absolute;
+    left: 0; right: 0; bottom: -6px;
+    height: 2px;
+    background: currentColor;
+    transform: scaleX(0);
+    transform-origin: left center;
+    transition: transform var(--t-base);
+  }
+  .menu-bar-link:hover::before,
+  .menu-bar-link[aria-current="page"]::before { transform: scaleX(1); }
+}
+
+
+/* TODO — siguiente iteración: dropdowns en hover para Productos / Soluciones.
+   Estructura sugerida:
+     <li class="menu-bar-item has-dropdown">
+       <button class="menu-bar-link" aria-expanded="false">Productos</button>
+       <div class="menu-bar-dropdown" role="menu">...</div>
+     </li>
+   El dropdown vive en este archivo (no en menu-drawer.css). */
diff -urN '--exclude=.git' /tmp/w2/assets/css/components/menu-drawer.css /tmp/w2-serve/assets/css/components/menu-drawer.css
--- /tmp/w2/assets/css/components/menu-drawer.css	1970-01-01 00:00:00.000000000 +0000
+++ /tmp/w2-serve/assets/css/components/menu-drawer.css	2026-04-25 23:56:07.461978368 +0000
@@ -0,0 +1,170 @@
+/* ==========================================================================
+   MENU-DRAWER.CSS — overlay fullscreen mobile (<960px)
+   --------------------------------------------------------------------------
+   · Vive a nivel de body (HERMANO del header), NO dentro de él.
+     Esto evita el clásico problema de stacking context: el drawer es
+     z-index:900, el header z-index:1000, así el header pinta encima del
+     drawer y la X / logo / WhatsApp siguen visibles cuando el drawer abre.
+   · Position fixed; inset:0; padding-top = nav-h para que el contenido del
+     drawer no quede tapado por el header.
+   · Submenús accordion: <button aria-expanded> + chevron que rota.
+   · Footer con redes sociales + CTA grande.
+   · Hidden ≥960px — ahí manda el .menu-bar dentro del header.
+
+   Secciones (Ctrl+F):
+     1) CONTAINER (visibility, transición open/close)
+     2) LIST + ITEMS (link, botón submenu, barra amarilla)
+     3) SUBMENÚS (accordion + chevron)
+     4) FOOTER (redes sociales + CTA)
+     5) DESKTOP (≥960px) — oculto
+   ========================================================================== */
+
+
+/* === 1) CONTAINER ========================================================= */
+
+.menu-drawer {
+  position: fixed;
+  inset: 0;
+  background: var(--c-bg);
+  color: var(--c-text);
+  z-index: var(--z-menu);     /* 900 — debajo del .nav (1000) */
+  display: flex;
+  flex-direction: column;
+  /* Reserva el alto del nav (que se pinta encima por z-index global). */
+  padding: var(--nav-h) 0 0;
+
+  /* Visibilidad: visibility para evitar clicks cuando está oculto. */
+  opacity: 0;
+  visibility: hidden;
+  pointer-events: none;
+  transition: opacity .25s ease, visibility 0s linear .25s;
+}
+.menu-drawer.is-open {
+  opacity: 1;
+  visibility: visible;
+  pointer-events: auto;
+  transition: opacity .25s ease, visibility 0s;
+}
+
+
+/* === 2) LIST + ITEMS ====================================================== */
+
+.menu-drawer-list {
+  flex: 1;
+  overflow-y: auto;
+  list-style: none;
+  margin: 0;
+  padding: var(--sp-3) 0;
+}
+
+/* .menu-drawer-link aplica a <a> y a <button> indistintamente */
+.menu-drawer-link {
+  position: relative;
+  display: flex;
+  width: 100%;
+  align-items: center;
+  justify-content: space-between;
+  gap: var(--sp-3);
+  padding: var(--sp-4) var(--sp-5);
+  font: inherit;
+  font-size: 17px;
+  font-weight: var(--fw-medium);
+  color: inherit;
+  text-align: left;
+  background: transparent;
+  border: 0;
+  cursor: pointer;
+  -webkit-tap-highlight-color: transparent;
+  transition: background var(--t-fast);
+}
+.menu-drawer-link:hover { background: rgba(0,0,0,.03); }
+
+/* Barra vertical amarilla a la izquierda en hover/active/expanded. */
+.menu-drawer-link::before {
+  content: "";
+  position: absolute;
+  left: 0; top: 25%; bottom: 25%;
+  width: 4px;
+  background: var(--c-accent);
+  opacity: 0;
+  transition: opacity var(--t-fast);
+}
+.menu-drawer-link:hover::before,
+.menu-drawer-link[aria-current="page"]::before,
+.menu-drawer-link[aria-expanded="true"]::before { opacity: 1; }
+
+
+/* === 3) SUBMENÚS — accordion ============================================== */
+
+.menu-drawer-chevron {
+  width: 14px; height: 14px;
+  fill: currentColor;
+  opacity: .55;
+  transition: transform var(--t-base);
+  flex-shrink: 0;
+}
+[aria-expanded="true"] > .menu-drawer-chevron { transform: rotate(180deg); }
+
+/* Wrapper del submenu. Estructura HTML:
+     <div class="menu-drawer-sublist"><ul>...</ul></div>
+   El truco grid-template-rows 0fr→1fr anima la altura sin medir DOM.
+   Soporte: Chrome 117+, FF 121+, Safari 17+. */
+.menu-drawer-sublist {
+  display: grid;
+  grid-template-rows: 0fr;
+  transition: grid-template-rows var(--t-base);
+}
+.menu-drawer-sublist > ul {
+  overflow: hidden;
+  min-height: 0;
+  list-style: none;
+  margin: 0; padding: 0;
+}
+[aria-expanded="true"] + .menu-drawer-sublist { grid-template-rows: 1fr; }
+
+.menu-drawer-sublist a {
+  display: block;
+  padding: var(--sp-3) var(--sp-5) var(--sp-3) calc(var(--sp-5) + var(--sp-6));
+  font-size: 15px;
+  font-weight: var(--fw-regular);
+  color: var(--c-text-soft);
+  transition: color var(--t-fast);
+}
+.menu-drawer-sublist a:hover { color: var(--c-text); }
+
+
+/* === 4) FOOTER (redes sociales + CTA) ===================================== */
+
+.menu-drawer-footer {
+  border-top: 1px solid var(--c-border);
+  padding: var(--sp-5);
+  display: flex;
+  flex-direction: column;
+  gap: var(--sp-4);
+}
+
+.menu-drawer-social {
+  display: flex;
+  gap: var(--sp-2);
+  list-style: none;
+  margin: 0; padding: 0;
+}
+.menu-drawer-social a {
+  width: 40px; height: 40px;
+  display: inline-flex;
+  align-items: center; justify-content: center;
+  border-radius: 50%;
+  color: inherit;
+  transition: background var(--t-fast);
+}
+.menu-drawer-social a:hover { background: rgba(0,0,0,.06); }
+.menu-drawer-social svg { width: 20px; height: 20px; fill: currentColor; }
+
+.menu-drawer-cta { width: 100%; justify-content: center; }
+
+
+/* === 5) DESKTOP (≥960px) — oculto ========================================= */
+
+@media (min-width: 960px) {
+  .menu-drawer { display: none; }
+}
