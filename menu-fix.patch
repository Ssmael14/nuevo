diff -urN '--exclude=.git' /tmp/w2/assets/css/components/menu.css ./assets/css/components/menu.css
--- /tmp/w2/assets/css/components/menu.css	2026-04-25 17:50:16.857271076 +0000
+++ ./assets/css/components/menu.css	2026-04-25 17:58:40.904439606 +0000
@@ -173,6 +173,9 @@
     position: static;
     inset: auto;
     background: none;
+    color: inherit;           /* sin esto el .menu mantiene var(--c-text) (negro)
+                                 y los .menu-link, que usan color:inherit, lo heredan,
+                                 quedando negros sobre el hero oscuro */
     z-index: auto;
